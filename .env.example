# Database
DATABASE_URL=postgresql://user:password@localhost:5432/taxi_db

# JWT Secret
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=43200

# Telegram Bots
# Get tokens from @BotFather on Telegram
# User Bot - for customers to book taxis and deliveries
USER_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz1234567890

# Admin Bot - for admins to manage applications and orders
ADMIN_BOT_TOKEN=0987654321:ZYXwvuTSRqpONMlkjIHGfeDCBA0987654321

# Admin Telegram Chat ID (get from @userinfobot)
TELEGRAM_ADMIN_CHAT_ID=123456789

# Telegram channel for order alerts
TELEGRAM_ORDER_BOT_TOKEN=8242937115:AAGGc_voT2O_AYWR0LQH-O12_-y9m7NYm28
TELEGRAM_ORDER_CHANNEL_ID=-1003583108629

# File Upload
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=5242880

# Redis (for caching and background tasks)
REDIS_URL=redis://localhost:6379/0

# App Settings
APP_NAME=Taxi Service
APP_VERSION=1.0.0
DEBUG=True

# CORS (comma-separated list of allowed origins)
# Example: http://localhost:3000,https://frontend.example.com
CORS_ORIGINS=http://localhost:3000
# Optional regex for wildcard origins (e.g., allow all subdomains)
# Example: https://.*\.omad-driver\.uz
CORS_ALLOW_ORIGIN_REGEX=

# CLICK (Uzbekistan) payment integration
CLICK_SERVICE_ID=94101
CLICK_MERCHANT_ID=55408
CLICK_SECRET_KEY=change-me
# Optional
CLICK_MERCHANT_USER_ID=76236
# Optional comma-separated IP allowlist (empty disables allowlist)
CLICK_ALLOWED_IPS=

# Firebase Cloud Messaging (FCM)
FCM_ENABLED=True
# Option 1: path to Firebase service account JSON file
FCM_SERVICE_ACCOUNT_FILE=
# Option 2: full service account JSON as one-line string
FCM_SERVICE_ACCOUNT_JSON=
